# Secrets for the booking-notify Edge Function.
# Set them in Supabase (Edge Functions → Secrets), or with the CLI:
#   supabase secrets set --env-file ./supabase/functions/booking-notify/.env
# Copy this file to .env (which git ignores), fill it in, and NEVER commit the real values.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions automatically;
# don't add them here and never put the service role key in the website.

# A long random string. The Database Webhook sends it in the "x-webhook-secret" header.
WEBHOOK_SECRET=

# Where new-booking alerts go.
OWNER_EMAIL=astrojumpersco@gmail.com

# Email service: "brevo" (works with a Gmail sender address) or "resend" (needs your own domain).
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
FROM_EMAIL=astrojumpersco@gmail.com
FROM_NAME=Astro Jumpers

# Used in the emails.
BUSINESS_NAME=Astro Jumpers
BUSINESS_PHONE=(806) 382-2097
SITE_URL=https://caylor-made-technologies.github.io/astro-jumpers-website/
